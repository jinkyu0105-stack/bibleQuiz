{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "biblequiz-app",
  "main": "./workers/app/index.ts",
  "compatibility_date": "2026-08-25",
  "keep_vars": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "biblequiz-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "preview_database_id": "biblequiz-local",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "preview": {
      "name": "biblequiz-app-preview",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "ADMIN_COMPUTE_ENABLED": "true",
        "AI_GENERATION_ENABLED": "false",
        "CONTENT_FINAL_CHECK_WORKFLOW_ENABLED": "false",
        "CONTENT_DISPLAY_PREPARATION_ENABLED": "false",
        "CONTENT_DISPLAY_PREPARATION_SERMON_IDS": "[]",
        "P571_SYNTHETIC_SERMON_IDS": "[]",
        "DRAFT_CLEANUP_ENABLED": "false"
      },
      "workflows": [{
        "binding": "CONTENT_WORKFLOW",
        "name": "biblequiz-content-preview",
        "class_name": "PreviewMeasurementWorkflow",
        "script_name": "biblequiz-content-preview"
      }],
      "durable_objects": {
        "bindings": [{ "name": "ADMIN_COMPUTE", "class_name": "AdminCompute" }]
      },
      "migrations": [{ "tag": "admin-compute-v1", "new_sqlite_classes": ["AdminCompute"] }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "biblequiz-d1-preview",
          "database_id": "cb044032-7e26-452b-afae-b0cae3d93678",
          "preview_database_id": "cb044032-7e26-452b-afae-b0cae3d93678",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
