{
  "name": "bible-quiz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.14.0 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:preview": "tsc -b && CLOUDFLARE_ENV=preview vite build",
    "preview": "pnpm run build && vite preview",
    "deploy:preview:dry-run": "pnpm run build:preview && wrangler deploy --dry-run --strict --autoconfig=false",
    "deploy:preview": "pnpm run build:preview && wrangler deploy --strict --autoconfig=false",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "test": "pnpm run test:unit && pnpm run test:worker",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "cf:types": "wrangler types",
    "db:generate": "TMPDIR=/tmp TEMP=/tmp TMP=/tmp drizzle-kit generate",
    "db:check": "TMPDIR=/tmp TEMP=/tmp TMP=/tmp drizzle-kit check",
    "db:migrate:local": "wrangler d1 migrations apply biblequiz-local --local",
    "db:migrations:list:local": "wrangler d1 migrations list biblequiz-local --local",
    "db:migrate:preview": "wrangler d1 migrations apply biblequiz-d1-preview --remote --env preview",
    "db:migrations:list:preview": "wrangler d1 migrations list biblequiz-d1-preview --remote --env preview",
    "check:locks": "node scripts/check-lockfiles.mjs",
    "check:cloudflare": "node scripts/check-cloudflare-config.mjs",
    "check": "pnpm run check:locks && pnpm run check:cloudflare && pnpm run db:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "hono": "4.13.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@cloudflare/vitest-plugin": "1.0.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  }
}
