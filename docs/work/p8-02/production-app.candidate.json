{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-25",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": false
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "biblequiz-d1",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../../migrations"
    }
  ],
  "name": "biblequiz-app",
  "main": "../../../workers/app/index.ts",
  "keep_vars": true,
  "assets": {
    "directory": "../../../dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "AI_GENERATION_ENABLED": "false",
    "AI_RESPONSE_ARCHIVE_ENABLED": "false",
    "CONTENT_FINAL_CHECK_WORKFLOW_ENABLED": "false",
    "CONTENT_DISPLAY_PREPARATION_ENABLED": "false",
    "DRAFT_CLEANUP_ENABLED": "false",
    "BACKUP_ENABLED": "false",
    "OPERATIONS_CRON_ENABLED": "false",
    "PUBLIC_RATE_LIMIT_ENABLED": "false",
    "CONTENT_DISPLAY_PREPARATION_SERMON_IDS": "[]",
    "P571_SYNTHETIC_SERMON_IDS": "[]",
    "ADMIN_COMPUTE_ENABLED": "true",
    "OPERATIONS_ENVIRONMENT": "production",
    "D1_DATABASE_ID": "00000000-0000-0000-0000-000000000001",
    "BACKUP_BUCKET_NAME": "biblequiz-backups"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ADMIN_COMPUTE",
        "class_name": "AdminCompute"
      }
    ]
  },
  "migrations": [
    {
      "tag": "admin-compute-v1",
      "new_sqlite_classes": [
        "AdminCompute"
      ]
    }
  ],
  "workflows": [
    {
      "binding": "CONTENT_WORKFLOW",
      "name": "biblequiz-content-workflow",
      "class_name": "ContentWorkflow",
      "script_name": "biblequiz-content"
    },
    {
      "binding": "BACKUP_WORKFLOW",
      "name": "biblequiz-backup-workflow",
      "class_name": "BackupWorkflow",
      "script_name": "biblequiz-backup"
    }
  ],
  "ratelimits": [
    {
      "name": "PUBLIC_SESSION_LIMIT",
      "namespace_id": "80221",
      "simple": {
        "limit": 100,
        "period": 10
      }
    },
    {
      "name": "PUBLIC_ACTOR_LIMIT",
      "namespace_id": "80222",
      "simple": {
        "limit": 6,
        "period": 10
      }
    },
    {
      "name": "PUBLIC_GUEST_LIMIT",
      "namespace_id": "80223",
      "simple": {
        "limit": 100,
        "period": 10
      }
    }
  ]
}
