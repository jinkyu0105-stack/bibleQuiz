{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-25",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": false
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "biblequiz-d1",
      "database_id": "fc0ae671-9300-49a2-a099-994b1446e9cc",
      "migrations_dir": "../../migrations"
    }
  ],
  "name": "biblequiz-backup",
  "main": "index.ts",
  "vars": {
    "OPERATIONS_ENVIRONMENT": "production",
    "CLOUDFLARE_ACCOUNT_ID": "c975020ce569ec52da63732ba0b94422",
    "BACKUP_ENABLED": "true",
    "D1_DATABASE_ID": "fc0ae671-9300-49a2-a099-994b1446e9cc",
    "BACKUP_BUCKET_NAME": "biblequiz-backups"
  },
  "r2_buckets": [
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "biblequiz-backups"
    }
  ],
  "workflows": [
    {
      "binding": "BACKUP_WORKFLOW",
      "name": "biblequiz-backup-workflow",
      "class_name": "BackupWorkflow"
    }
  ],
  "account_id": "c975020ce569ec52da63732ba0b94422",
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "triggers": {
    "crons": [
      "*/10 * * * *",
      "0 19 * * SUN"
    ]
  }
}
