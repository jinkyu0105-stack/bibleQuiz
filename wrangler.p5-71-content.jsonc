{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "biblequiz-content-measurement-unconfigured",
  "main": "./workers/content/preview-measurement.ts",
  "compatibility_date": "2026-08-25",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "env": {
    "preview": {
      "name": "biblequiz-content-preview",
      "workers_dev": false,
      "preview_urls": false,
      "vars": { "P571_MEASUREMENT_ENABLED": "false", "P571_SCENARIO": "success", "AI_RESPONSE_ARCHIVE_ENABLED": "false",
        "CONTENT_DISPLAY_PREPARATION_ENABLED": "false", "CONTENT_DISPLAY_PREPARATION_SERMON_IDS": "[]" },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "biblequiz-d1-preview",
        "database_id": "cb044032-7e26-452b-afae-b0cae3d93678",
        "migrations_dir": "migrations"
      }],
      "workflows": [{
        "binding": "CONTENT_WORKFLOW",
        "name": "biblequiz-content-preview",
        "class_name": "PreviewMeasurementWorkflow"
      }]
    }
  }
}
